#!/command/with-contenv sh
# Create runtime folders, hand them to the brief user, and render the Vector config.
# Vector 0.58 does not interpolate ${VAR} by default and the sender allowlist is a list, so the
# listen port and allowlist are rendered into /run/vector/vector.yaml from brief/network.yaml (and
# SYSLOG_PORT) by `python -m brief.vectorcfg`, which validates them. A bad value stops the
# container with a message in the log instead of quietly weakening the allowlist.
set -e
mkdir -p /state/vector /state/vector-import /state/events /archive /out /www /run/vector
# /config/brief is where the admin GUI and the `brief config` command write your settings (not recursive:
# files you put there yourself keep their owner).
# A read-only mount is a legitimate setup (settings are then changed on the host), so this must not stop the start.
mkdir -p /config/brief 2>/dev/null || true
chown brief:users /config/brief 2>/dev/null || true
chown brief:users /state /state/vector /state/vector-import /state/events /archive /out /www /run/vector

python -m brief.vectorcfg
chown brief:users /run/vector/vector.yaml
