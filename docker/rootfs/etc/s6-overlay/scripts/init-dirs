#!/command/with-contenv sh
# Create runtime folders, hand them to the brief user, and render the Vector config.
# Vector 0.58 does not interpolate ${VAR} by default, so the one setting we need from the
# environment (the syslog port) is substituted here after checking it is a valid port number.
set -e
mkdir -p /state/vector /archive /out /www /run/vector
chown brief:users /state /state/vector /archive /out /www /run/vector

port="${SYSLOG_PORT:-514}"
case "$port" in
  ''|*[!0-9]*) echo "init-dirs: SYSLOG_PORT must be a number, got '$port'" >&2; exit 1 ;;
esac
[ "$port" -ge 1 ] && [ "$port" -le 65535 ] || { echo "init-dirs: SYSLOG_PORT out of range: $port" >&2; exit 1; }

sed "s/\${SYSLOG_PORT:-514}/$port/g" /config/vector/vector.yaml > /run/vector/vector.yaml
chown brief:users /run/vector/vector.yaml
