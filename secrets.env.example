# Template variables for the homelab-brief container. On Unraid these are set in the
# container template; locally, copy this file to secrets.env (gitignored) for dev.
# Never put real values in this example file.

# MQTT broker (temporary Mosquitto now, Home Assistant's Mosquitto add-on later)
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=brief
MQTT_PASSWORD=change-me
# Dev only: used by scripts/dev-init.ps1 to create the ha user on the dev broker
MQTT_HA_PASSWORD=change-me-too

# Display timezone for rendered views; files stay in UTC
DISPLAY_TZ=UTC

# Admin GUI: no default password. Set it with `brief admin set-password`, or leave this
# empty to get a one-time setup token in the container log on first start.
ADMIN_SETUP_TOKEN=

# Optional SSH server inside the container (key-only; keys in /config/ssh/authorized_keys)
SSH_ENABLED=false

# Phase 2 collectors (read-only accounts or keys). Leave each empty until its collector is enabled.
# One read-only Unraid API key per server; add or remove lines to match config in brief/collectors.yaml.
UNRAID_SERVER_1_API_KEY=
# (second server)
UNRAID_SERVER_2_API_KEY=
# (third server)
UNRAID_SERVER_3_API_KEY=
# UniFi Network
UNIFI_URL=
# (API key for UniFi)
UNIFI_API_KEY=
# iDRAC
IDRAC_HOST=
# (iDRAC user)
IDRAC_USER=
# (iDRAC password)
IDRAC_PASSWORD=
# SNMP v3
SNMP_V3_USER=
# (auth key)
SNMP_V3_AUTH_KEY=
# (privacy key)
SNMP_V3_PRIV_KEY=
# DNS filter (optional)
DNS_FILTER_URL=
# (DNS filter token)
DNS_FILTER_TOKEN=

# AI providers (see brief/ai.yaml). Names here must match each provider's api_key_var.
# Leave empty when a provider needs no key (for example Ollama behind a firewall rule).
AI_LOCAL_API_KEY=
# (hosted provider)
AI_CLOUD_API_KEY=

# Optional notifications
APPRISE_URLS=
# SNMP v2c community (only if you use v2c instead of v3)
SNMP_COMMUNITY=
