# Keep Unix line endings for everything that runs on Unraid or in containers.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.md text eol=lf
mosquitto/acl text eol=lf

# Windows-only helpers keep CRLF.
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.ttf binary
*.otf binary
